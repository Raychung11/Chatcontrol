# Copy to ".env" and adjust before running docker-compose.evolution.yml.

# Public URL Evolution will advertise in webhook events. Set to the HTTPS
# URL of the proxy in front of port 8080 (e.g. https://evo.your-domain.com).
EVOLUTION_PUBLIC_URL=http://localhost:8080

# Random secret - rotate periodically. Paste this same value into the
# AiServe portal: Admin → Settings → Evolution API key.
# Generate one with:  openssl rand -hex 32
EVOLUTION_API_KEY=please-change-me
